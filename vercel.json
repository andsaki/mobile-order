{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["storybook-static/**"]
      }
    },
    {
      "src": "storybook-static/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/storybook/(.*)",
      "dest": "/storybook-static/index.html"
    }
  ]
}
